# Portfolio shared matplotlib style
# Colours are set from the design-system tokens in _portfolio.use_portfolio_style(), not here.

font.family:         sans-serif
font.size:           12

figure.edgecolor:    none
figure.dpi:          150

axes.linewidth:      0.75
axes.spines.top:     False
axes.spines.right:   False
axes.grid:           True
axes.grid.axis:      y
axes.labelsize:      11
axes.titlesize:      12
axes.titleweight:    500

grid.linewidth:      0.5
grid.linestyle:      -

lines.linewidth:     1.5


xtick.labelsize:     10
xtick.major.size:    3
xtick.major.width:   0.5
ytick.labelsize:     10
ytick.major.size:    3
ytick.major.width:   0.5

legend.frameon:      False
legend.fontsize:     10

svg.fonttype:        none
